@@ -0,0 +1,43 @@
+"""LLM-visible explicit object marking; routing is learned from actual vision peers."""
+from dataclasses import dataclass,field
+import json
+import uuid
+from typing import Any
+from astrbot.api import FunctionTool
+from astrbot.core.astr_agent_context import AstrAgentContext
+
+
+@dataclass
+class SetVisionMarksTool(FunctionTool[AstrAgentContext]):
+    name: str='set_astrbotex_vision_marks'
+    description: str=(
+        'Explicitly mark or unmark one or more objects read from the AstrBotEX vision JSON buffer. '
+        'Use their exact stream_id and object IDs. marked=true persists act=1 across subsequent '
+        'frames and restarts; only an explicit marked=false clears it. Other object marks stay '
+        'unchanged. This annotates objects only and does not move the robot. A missing object '
+        'retains its mark in the marks ledger. Reuse request_id when retrying an uncertain call.'
+    )
+    parameters: dict=field(default_factory=lambda:{
+        'type':'object','additionalProperties':False,
+        'properties':{'stream_id':{'type':'string'},'ids':{'type':'array','items':{'type':'string'},'minItems':1,'maxItems':100},
+                      'marked':{'type':'boolean'},'request_id':{'type':'string','description':'Optional idempotency key; reuse for retries'}},
+        'required':['stream_id','ids','marked']})
+    plugin: Any=None
+
+    async def call(self,context,**kwargs):
+        del context
+        if self.plugin is None:return json.dumps({'ok':False,'error':'vision marks not initialized'})
+        request=kwargs.get('request_id') or uuid.uuid4().hex
+        payload={'request_id':request,'stream_id':kwargs.get('stream_id'),'ids':kwargs.get('ids'),'marked':kwargs.get('marked')}
+        try:
+            if not isinstance(payload['stream_id'],str) or type(payload['marked']) is not bool:
+                raise ValueError('stream_id and boolean marked are required')
+            ids=payload['ids']
+            if not isinstance(ids,list) or not 1<=len(ids)<=100 or any(not isinstance(x,str) for x in ids):
+                raise ValueError('ids must contain 1..100 exact object IDs')
+            peer=self.plugin._vision_mark_routes.get(payload['stream_id'])
+            if peer is None:raise ValueError('No live vision route for this stream; read fresh vision JSON first')
+            reply=await self.plugin.text_channel.request('vision.mark.set',payload,peer=peer)
+            return json.dumps(reply.payload,ensure_ascii=False)
+        except Exception as exc:
+            return json.dumps({'ok':False,'request_id':request,'error':str(exc)[:300]},ensure_ascii=False)
